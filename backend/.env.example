# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated extra origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/recircle_ai

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI microservice ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace-with-shared-internal-key
AI_TIMEOUT_MS=20000

# ---- Cloudinary (optional; local disk storage is used when blank) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email via SMTP (optional; emails are logged to console when blank) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ReCircle AI <no-reply@recircle.local>"

# ---- Razorpay TEST mode (optional; cash on handover when blank) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public URL of this backend (used to build local upload URLs)
PUBLIC_API_URL=http://localhost:5000
