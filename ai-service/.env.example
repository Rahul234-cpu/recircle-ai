# Shared secret; must equal AI_SERVICE_KEY in backend/.env
AI_SERVICE_KEY=replace-with-shared-internal-key
PORT=8000

# ---- Image classification (optional) ----
# With a Hugging Face token, waste images are classified with CLIP zero-shot.
# Without it, a clearly-labelled demo heuristic is used.
HF_API_TOKEN=
HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/models/openai/clip-vit-base-patch32

# ---- LLM for descriptions / chatbot phrasing (optional) ----
# Any OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
