# Each service has its own .env.example with full documentation:
#   backend/.env.example     (MongoDB, JWT, Cloudinary, SMTP, Razorpay, AI service URL)
#   ai-service/.env.example  (shared key, Hugging Face vision, LLM)
#   frontend/.env.example    (VITE_API_URL)
#
# The one value that must match across services:
AI_SERVICE_KEY=replace-with-shared-internal-key
